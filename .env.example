# AI Companion Platform Environment Variables
# Copy to .env or configure directly via in-app Settings modal

PORT=5000

# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional: OpenAI / Groq / OpenRouter API Key
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional: Supabase configuration (if using Supabase instead of local file DB)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

