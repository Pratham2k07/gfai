{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__url=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.js?__url=/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
