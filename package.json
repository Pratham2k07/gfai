{
  "name": "gai",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:split": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run bundle:api && npm run build --workspace=client && node -e \"import('fs').then(fs => { if(fs.existsSync('dist')) { fs.mkdirSync('client/dist', { recursive: true }); fs.cpSync('dist', 'client/dist', { recursive: true }); } })\"",
    "bundle:api": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "build:server": "npm run build --workspace=server",
    "start": "npm run start --workspace=server"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Customizable AI Companion Chat Platform",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
